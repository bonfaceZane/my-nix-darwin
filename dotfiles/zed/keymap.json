[
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j k": "vim::NormalBefore",
    },
  },
  {
    "context": "(vim_mode == normal || vim_mode == visual || vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "bindings": {
      "s": ["vim::PushSneak", {}],
      "shift-s": ["vim::PushSneakBackward", {}],
    },
  },
  // VS Code-compatible shortcuts that do not replace core JetBrains bindings.
  {
    "context": "Workspace",
    "use_key_equivalents": true,
    "bindings": {
      "cmd-shift-p": "command_palette::Toggle",
      "cmd-shift-e": "project_panel::ToggleFocus",
      "ctrl-shift-g": "git_panel::ToggleFocus",
      "cmd-shift-d": "debug_panel::ToggleFocus",
      "cmd-shift-x": "zed::Extensions",
      "ctrl-`": "terminal_panel::Toggle",
      "cmd-k z": "workspace::ToggleCenteredLayout",
    },
  },
  {
    "context": "Editor",
    "use_key_equivalents": true,
    "bindings": {
      "shift-alt-f": "editor::Format",
      "cmd-k cmd-f": "editor::FormatSelections",
      "alt-z": "editor::ToggleSoftWrap",
      "cmd-k f12": "editor::GoToDefinitionSplit",
    },
  },
  {
    "bindings": {
      "cmd-j": "workspace::ToggleBottomDock",
    },
  },
  {
      "context": "(VimControl && ! menu)",
      "bindings": {
        "space": null
      }
  },
]
