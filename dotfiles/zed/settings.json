// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    // editor
    "diff_view_style": "unified",
    "minimap": {
        "show": "auto"
    },
    "gutter": {
        "min_line_number_digits": 0
    },
    "agent": {
        "tool_permissions": {
            "tools": {
                "create_directory": {
                    "default": "allow"
                }
            }
        },
        "default_model": {
            "provider": "google",
            "model": "gemini-2.5-flash-lite"
        },
        "dock": "right",
        "favorite_models": [
            {
                "provider": "google",
                "model": "gemini-2.5-flash-lite"
            },
            {
                "provider": "google",
                "model": "gemini-2.0-flash"
            },
            {
                "provider": "ollama",
                "model": "qwen2.5-coder:7b"
            }
        ],
        "model_parameters": [],
        "commit_message_model": {
            "provider": "google",
            "model": "gemini-3.5-flash"
        },
        "commit_message_instructions": "Generate a concise Conventional Commit message. Use an imperative subject in the format <type>(<scope>): <description>, keep the subject under 72 characters, and return only the commit message without quotes, Markdown, or explanation."
    },
    "outline_panel": {
        "dock": "right"
    },
    "collaboration_panel": {
        "dock": "right"
    },
    "icon_theme": {
        "mode": "light",
        "light": "Material Icon Theme",
        "dark": "Material Icon Theme"
    },
    "session": {
        "trust_all_worktrees": true
    },
    "terminal": {
        "font_size": 19
    },
    "base_keymap": "JetBrains",
    "theme": {
        "mode": "system",
        "light": "One Light",
        "dark": "Night Owl Dark"
    },
    "ui_font_size": 20.0,
    "buffer_font_size": 18.0,
    "autosave": "on_focus_change",
    "project_panel": {
        // "button": true,
        "default_width": 500,
        /* This controls the horizontal indentation of folders */
        "indent_size": 35.0,
        /* Use "compact" for more items or "comfortable" for more padding */
        "entry_spacing": "comfortable",
        "git_status": true,
        "dock": "right",
        "indent_guides": {
            "show": "always"
        }
    },
    "hard_tabs": false,
    "tab_size": 4,
    "show_edit_predictions": true,
    "edit_predictions": {
        "provider": "zed",
        "mode": "eager"
    },

    // git
    "git_panel": {
        "tree_view": false,
        "dock": "right",
        "default_width": 550.0
    },

    "show_whitespaces": "none",

    // Helix mode includes Vim mode and provides the space-prefix keymap.
    "helix_mode": true,
    "which_key": {
        "enabled": true,
        "delay_ms": 200
    },
    "auto_signature_help": false,
    "vim": {
        "use_smartcase_find": true
    },

    "context_servers": {
        "memory": {
            "source": "custom",
            "command": "npx",
            "args": ["-y", "@modelcontextprotocol/server-memory"]
        },
        "git": {
            "source": "custom",
            "env": {},
            "command": "npx",
            "args": ["-y", "@modelcontextprotocol/server-git"]
        }
    },
    "experimental.theme_overrides": {
        "editor.active_line.background": "#ADECE415"
    },
    "preferred_line_length": 80,
    "languages": {
        "Nix": {
            "hard_tabs": true,
            "tab_size": 4
        }
    }
}
