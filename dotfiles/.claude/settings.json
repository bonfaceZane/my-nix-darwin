{
    "permissions": {
        "defaultMode": "acceptEdits",
        "allow": [
            "Read",
            "Glob",
            "Grep",
            "Edit",
            "Write",
            "Bash(nix:*)",
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git show:*)",
            "Bash(git add:*)",
            "Bash(git commit:*)",
            "Bash(ls:*)",
            "Bash(cat:*)",
            "Bash(rg:*)",
            "Bash(fd:*)",
            "Bash(jq:*)",
            "Bash(ast-grep:*)",
            "Bash(repomix:*)",
            "Bash(mkdir:*)",
            "Bash(touch:*)",
            "Bash(npm:*)",
            "Bash(yarn:*)"
        ],
        "deny": [
            "Read(secrets.yaml)",
            "Read(.env*)",
            "Read(.sops.yaml)",
            "Read(~/.ssh/**)",
            "Read(~/.aws/**)",
            "Bash(sops:*)",
            "Bash(rm:*)",
            "Bash(sudo:*)",
            "Bash(chmod:*)",
            "Bash(chown:*)",
            "Bash(git push --force:*)",
            "Bash(git reset --hard:*)",
            "Bash(git clean:*)",
            "Bash(curl:* | sh)",
            "Bash(curl:* | bash)",
            "mcp__expo__add_library",
            "mcp__expo__workflow_create",
            "mcp__expo__workflow_run",
            "mcp__expo__workflow_cancel",
            "mcp__expo__build_run",
            "mcp__expo__build_cancel",
            "mcp__expo__build_submit",
            "mcp__expo__appstore_reply_review",
            "mcp__expo__appstore_delete_review_response",
            "mcp__expo__playstore_reply_review",
            "mcp__expo__automation_tap",
            "mcp__expo__automation_take_screenshot",
            "mcp__expo__collect_app_logs"
        ],
        "ask": [
            "Bash(git push:*)",
            "Bash(brew:*)",
            "Bash(darwin-rebuild:*)",
            "Bash(npm install -g:*)",
            "Bash(pip install:*)",
            "mcp__expo"
        ]
    }
}
