{
    "general": {
        "defaultApprovalMode": "default"
    },
    "permissions": {
        "deny": [
            "Read(secrets.yaml)",
            "Read(.env*)",
            "Read(.sops.yaml)",
            "Read(~/.ssh/**)",
            "Read(~/.aws/**)",
            "Bash(sops:*)",
            "Bash(rm:*)",
            "Bash(sudo:*)",
            "Bash(chmod:*)",
            "Bash(chown:*)",
            "Bash(git push --force:*)",
            "Bash(git reset --hard:*)",
            "Bash(git clean:*)",
            "Bash(curl:* | sh)",
            "Bash(curl:* | bash)"
        ]
    },
    "context": {
        "fileName": ["AGENTS.md", "GEMINI.md"]
    },
    "mcpServers": {
        "maestro": {
            "command": "/opt/homebrew/bin/maestro",
            "args": ["mcp"],
            "env": {
                "JAVA_HOME": "/opt/homebrew/opt/openjdk/libexec/openjdk.jdk/Contents/Home"
            }
        },
        "radon": {
            "command": "npx",
            "args": ["-y", "radon-mcp@latest", "/Users/rafiki/Documents/work/amv-apps"]
        }
    }
}
