{

    "permissions": {
        "defaultMode": "acceptEdits",
        "allow": [
            "Read",
            "Glob",
            "Grep",
            "Bash(nix:*)",
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(npm:*)",
            "Bash(yarn:*)",
            "Bash(pnpm:*)",
            "Edit",
            "Write"
        ],
        "deny": ["Read(secrets.yaml)", "Read(**/.sops.yaml)", "Bash(sops:*)", "Bash(gh auth:*)"],
        "ask": ["Bash(git push:*)", "Bash(git commit:*)", "Bash(brew:*)", "Bash(darwin-rebuild:*)"]
    },
    "mcpServers": {
        "GitKraken": {
            "args": [
                "mcp",
                "--host=antigravity",
                "--source=gitlens",
                "--scheme=antigravity"
            ],
            "command": "gitkraken-mcp",
            "type": "stdio"
        }
    }
}
