{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(nix:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(jq:*)",
      "Bash(ast-grep:*)",
      "Bash(repomix:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(npm:*)",
      "Bash(yarn:*)"
    ],
    "deny": [
      "Read(secrets.yaml)",
      "Read(.env*)",
      "Read(.sops.yaml)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(sops:*)",
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(curl:* | sh)",
      "Bash(curl:* | bash)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(brew:*)",
      "Bash(darwin-rebuild:*)",
      "Bash(npm install -g:*)",
      "Bash(pip install:*)"
    ]
  }
}
